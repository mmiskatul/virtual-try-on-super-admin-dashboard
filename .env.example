# Backend API (production: https://api.vtrystudio.com)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000
# NextAuth JWT encryption secret (generate with: openssl rand -hex 32)
NEXTAUTH_SECRET=
# Google OAuth client (same client the backend uses).
# Note: the dashboard currently fetches the public client ID from the backend
# (GET /api/v1/admin/auth/google-config) and uses Google's token flow, so these two are kept for
# reference and are not read by the app today. The backend .env needs GOOGLE_CLIENT_ID and SEED_ADMIN_EMAIL.
# Google Cloud Console: add this site's URL to "Authorized JavaScript origins" (no redirect URI needed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
