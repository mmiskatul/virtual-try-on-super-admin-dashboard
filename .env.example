NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXTAUTH_URL=http://localhost:3002
# NextAuth JWT encryption secret (generate with: openssl rand -hex 32)
NEXTAUTH_SECRET=

# Google sign-in: the dashboard fetches the public client ID from the backend (GET /api/v1/admin/auth/google-config),
# so nothing is required here. Set GOOGLE_CLIENT_ID and SEED_ADMIN_EMAIL (your Google email) in the BACKEND .env.
# In Google Cloud Console, add this site's URL (e.g. http://localhost:3002) to the OAuth client's
# "Authorized JavaScript origins". No redirect URI is needed (Google Identity Services token flow).

